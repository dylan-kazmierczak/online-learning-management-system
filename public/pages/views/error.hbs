<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm border-start border-danger border-5">
        <div class="card-body p-4">
          <h4 class="text-danger mb-3">⚠️ Error</h4>
          <p class="card-text text-muted mb-4">{{error}}</p>
          <div class="d-flex gap-2">
            <a href="/" class="btn btn-primary btn-sm">Go Home</a>
            <button onclick="history.back()" class="btn btn-outline-secondary btn-sm">Go Back</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
