<div class="container mt-5">
  <div class="row">
    <div class="col-md-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h3 class="card-title text-dark mb-4">Create New Course</h3>

          {{#if error}}
            <div class="alert alert-danger mb-4">{{error}}</div>
          {{/if}}

          <form method="POST" action="/create">
            <div class="form-group mb-3">
              <label for="title" class="form-label">Course Title</label>
              <input type="text" class="form-control" id="title" name="title" required placeholder="e.g., Introduction to Python">
            </div>

            <div class="form-group mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" id="description" name="description" rows="4" required placeholder="Describe the course..."></textarea>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label for="startDate" class="form-label">Start Date</label>
                  <input type="datetime-local" class="form-control" id="startDate" name="startDate" required>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label for="endDate" class="form-label">End Date</label>
                  <input type="datetime-local" class="form-control" id="endDate" name="endDate" required>
                </div>
              </div>
            </div>

            <div class="form-group mb-4">
              <label for="enrollmentLimit" class="form-label">Enrollment Limit</label>
              <input type="number" class="form-control" id="enrollmentLimit" name="enrollmentLimit" value="50" min="1">
            </div>

            <button type="submit" class="btn btn-primary">Create Course</button>
            <a href="/instructor-dashboard" class="btn btn-outline-secondary">Cancel</a>
          </form>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body">
          <h5 class="card-title text-dark">Tips for Creating a Course</h5>
          <ul class="small text-muted">
            <li>Choose a clear, descriptive title</li>
            <li>Write a detailed description</li>
            <li>Set appropriate start and end dates</li>
            <li>You can upload content after creation</li>
            <li>Add assignments to engage students</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
