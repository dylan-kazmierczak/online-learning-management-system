<!--
 * location: ~/public/pages/layouts/default.hbs
 * description: This HBS file sets up the basic structure and necessary resources for a web page.
 * 							It includes metadata for character set and viewport settings, links to external CSS
 * 							and JavaScript libraries (such as jQuery and Bootstrap), and placeholders for the
 * 							title and body content.
 * installation: Save this file with a .hbs extension and open it in a web browser to render the
 * 							 page.
 * usage: Replace {{title}} with your desired page title and {{body}} with your content. Customize
 *			  the links to assets and libraries as needed for your project.
-->

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="../../assets/truck.png" />
		<link rel="stylesheet" href="https://releases.jquery.com/git/ui/jquery-ui-git.css" />
		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
			rel="stylesheet"
			integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
			crossorigin="anonymous"
		/>
		<script
			src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
			integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
			crossorigin="anonymous"
		></script>
		<script
			src="https://code.jquery.com/jquery-3.7.1.js"
			integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4="
			crossorigin="anonymous"
		></script>
		<script
			src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"
			integrity="sha256-9zljDKpE/mQxmaR4V2cGVaQ7arF3CcXxarvgr7Sj8Uc="
			crossorigin="anonymous"
		></script>
		<style>
			:root {
				--primary: #10b981;
				--primary-dark: #059669;
				--primary-light: #d1fae5;
				--accent: #f97316;
				--accent-dark: #ea580c;
				--text: #1f2937;
				--text-light: #6b7280;
				--bg-light: #f9fafb;
				--bg-lighter: #f3f4f6;
				--border-radius: 12px;
				--shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
				--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
				--shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
				--shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
				--transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #f0fdfa 100%);
				color: var(--text);
				min-height: 100vh;
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				font-weight: 400;
				line-height: 1.6;
				letter-spacing: -0.01em;
			}

			.container {
				max-width: 1200px;
			}

			/* Animations */
			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(20px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes slideInLeft {
				from {
					opacity: 0;
					transform: translateX(-20px);
				}
				to {
					opacity: 1;
					transform: translateX(0);
				}
			}

			@keyframes pulse {
				0%, 100% {
					opacity: 1;
				}
				50% {
					opacity: 0.7;
				}
			}

			.card {
				animation: fadeInUp 0.5s ease-out;
			}

			/* Page Layout */
			.page-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				margin-bottom: 2.5rem;
				padding-bottom: 2rem;
				border-bottom: 2px solid rgba(16, 185, 129, 0.1);
				animation: slideInLeft 0.6s ease-out;
			}

			.page-header > div:first-child {
				flex: 1;
			}

			.page-header h1,
			.page-header h2 {
				margin: 0 0 0.5rem 0;
				font-size: 2.25rem;
				font-weight: 700;
				background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				letter-spacing: -0.02em;
			}

			.page-header p {
				margin: 0;
				color: var(--text-light);
				font-size: 0.95rem;
			}

			.btn-group-header {
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
				justify-content: flex-end;
			}

			/* Cards */
			.card {
				border: none;
				border-radius: var(--border-radius);
				box-shadow: var(--shadow-md);
				transition: var(--transition);
				overflow: hidden;
				background: white;
				position: relative;
			}

			.card::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 4px;
				background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
			}

			.card:hover {
				transform: translateY(-8px);
				box-shadow: var(--shadow-xl);
			}

			.card-header {
				background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(249, 115, 22, 0.05) 100%);
				border: none;
				padding: 1.5rem;
				border-bottom: 1px solid rgba(16, 185, 129, 0.1);
			}

			.card-title {
				margin: 0;
				font-weight: 600;
				font-size: 1.1rem;
				color: var(--primary);
				letter-spacing: -0.01em;
			}

			.card-body {
				padding: 1.5rem;
			}

			.card-footer {
				background: var(--bg-lighter);
				padding: 1rem 1.5rem;
				border-top: 1px solid rgba(16, 185, 129, 0.1);
			}

			/* Buttons */
			.btn {
				border-radius: var(--border-radius);
				font-weight: 600;
				padding: 0.625rem 1.25rem;
				transition: var(--transition);
				border: none;
				cursor: pointer;
				font-size: 0.95rem;
				letter-spacing: -0.01em;
				position: relative;
				overflow: hidden;
			}

			.btn::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: rgba(255, 255, 255, 0.2);
				transition: left 0.3s ease;
				z-index: -1;
			}

			.btn:hover::before {
				left: 100%;
			}

			.btn-primary {
				background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
				color: white;
				box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
			}

			.btn-primary:hover {
				box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
				transform: translateY(-2px);
			}

			.btn-primary:active {
				transform: translateY(0);
			}

			.btn-secondary {
				background: var(--bg-lighter);
				color: var(--primary);
				border: 2px solid var(--primary);
			}

			.btn-secondary:hover {
				background: var(--primary);
				color: white;
				box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
			}

			.btn-accent {
				background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
				color: white;
				box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
			}

			.btn-accent:hover {
				box-shadow: 0 8px 20px rgba(249, 115, 22, 0.4);
				transform: translateY(-2px);
			}

			.btn-outline-secondary {
				border: 2px solid var(--text-light);
				color: var(--text-light);
				background: transparent;
			}

			.btn-outline-secondary:hover {
				background: var(--text-light);
				color: white;
			}

			.btn-outline-danger {
				border: 2px solid #ef4444;
				color: #ef4444;
				background: transparent;
			}

			.btn-outline-danger:hover {
				background: #ef4444;
				color: white;
			}

			.btn-sm {
				padding: 0.5rem 0.875rem;
				font-size: 0.875rem;
			}

			.btn-lg {
				padding: 0.875rem 2rem;
				font-size: 1.1rem;
			}

			/* Headings */
			h1, h2, h3, h4, h5, h6 {
				color: var(--primary);
				font-weight: 700;
				margin-bottom: 0.5rem;
				letter-spacing: -0.01em;
			}

			h1 { font-size: 2.25rem; }
			h2 { font-size: 1.875rem; }
			h3 { font-size: 1.5rem; }
			h4 { font-size: 1.25rem; }
			h5 { font-size: 1.1rem; }
			h6 { font-size: 1rem; }

			.text-muted {
				color: var(--text-light) !important;
			}

			.text-dark {
				color: var(--text) !important;
			}

			/* Badges */
			.badge {
				padding: 0.5rem 0.875rem;
				font-weight: 600;
				font-size: 0.8rem;
				border-radius: 6px;
				letter-spacing: 0.5px;
				text-transform: uppercase;
				background: linear-gradient(135deg, var(--primary-light) 0%, rgba(16, 185, 129, 0.1) 100%);
				color: var(--primary);
				border: 1px solid rgba(16, 185, 129, 0.3);
			}

			.bg-success {
				background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
			}

			.text-white {
				color: white !important;
			}

			/* Tables */
			.table {
				border-collapse: separate;
				border-spacing: 0 0.5rem;
			}

			.table thead th {
				border: none;
				background: transparent;
				color: var(--primary);
				font-weight: 700;
				padding: 1rem 1.5rem;
				border-bottom: 2px solid rgba(16, 185, 129, 0.2);
				font-size: 0.95rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.table tbody td {
				padding: 1.25rem 1.5rem;
				border: none;
				vertical-align: middle;
			}

			.table tbody tr {
				background: white;
				box-shadow: var(--shadow-sm);
				transition: var(--transition);
				border-radius: 8px;
				overflow: hidden;
			}

			.table tbody tr:hover {
				box-shadow: var(--shadow-md);
				transform: translateY(-2px);
				background: linear-gradient(135deg, rgba(16, 185, 129, 0.02) 0%, rgba(249, 115, 22, 0.02) 100%);
			}

			/* Forms */
			.form-control,
			.form-select {
				border: 2px solid #e5e7eb;
				border-radius: var(--border-radius);
				padding: 0.75rem 1rem;
				transition: var(--transition);
				font-size: 0.95rem;
				background: white;
			}

			.form-control:focus,
			.form-select:focus {
				border-color: var(--primary);
				box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
				outline: none;
			}

			.form-control::placeholder {
				color: var(--text-light);
			}

			.form-label {
				font-weight: 600;
				color: var(--text);
				margin-bottom: 0.625rem;
				font-size: 0.95rem;
				letter-spacing: -0.01em;
			}

			.form-text {
				color: var(--text-light);
				font-size: 0.875rem;
			}

			/* Alerts */
			.alert {
				border-radius: var(--border-radius);
				border: 2px solid;
				padding: 1.25rem;
				border-left: 5px solid;
				animation: fadeInUp 0.4s ease-out;
			}

			.alert-light {
				background: white;
				border-color: #e5e7eb;
				border-left-color: var(--primary);
			}

			.alert-success {
				background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%);
				border-color: var(--primary);
				border-left-color: var(--primary);
				color: var(--primary);
			}

			.alert-danger {
				background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(239, 68, 68, 0.05) 100%);
				border-color: #ef4444;
				border-left-color: #ef4444;
				color: #dc2626;
			}

			/* Progress */
			.progress {
				height: 10px;
				border-radius: 6px;
				background-color: #e5e7eb;
				overflow: hidden;
				box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05);
			}

			.progress-bar {
				background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
				transition: width 0.6s ease;
				box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
			}

			/* Row gap */
			.row.g-3 > * {
				animation: fadeInUp 0.5s ease-out;
				animation-fill-mode: both;
			}

			.row.g-3 > :nth-child(1) { animation-delay: 0.1s; }
			.row.g-3 > :nth-child(2) { animation-delay: 0.2s; }
			.row.g-3 > :nth-child(3) { animation-delay: 0.3s; }
			.row.g-3 > :nth-child(n+4) { animation-delay: 0.4s; }

			/* Responsive */
			@media (max-width: 768px) {
				.page-header {
					flex-direction: column;
					align-items: flex-start;
				}

				.btn-group-header {
					width: 100%;
					margin-top: 1rem;
					justify-content: flex-start;
				}

				.page-header h1,
				.page-header h2 {
					font-size: 1.75rem;
				}

				h1 { font-size: 1.75rem; }
				h2 { font-size: 1.5rem; }
			}

			@media (max-width: 576px) {
				.page-header h1,
				.page-header h2 {
					font-size: 1.5rem;
				}

				.btn {
					padding: 0.5rem 1rem;
				}

				.table {
					font-size: 0.875rem;
				}

				.table thead th,
				.table tbody td {
					padding: 0.75rem;
				}
			}
		</style>
		<title>
			{{title}}
		</title>
	</head>

	<body>
		<!-- Navigation Bar -->
		<nav class="navbar navbar-expand-lg navbar-light" style="background: linear-gradient(90deg, #10b981 0%, #059669 100%); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2); position: sticky; top: 0; z-index: 1030;">
			<div class="container">
				<a class="navbar-brand fw-bold text-white" href="/" style="font-size: 1.5rem; letter-spacing: -0.02em;">🎓 LMS</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav ms-auto">
						{{#if user}}
							<li class="nav-item">
								{{#if (eq user.role 'Student')}}
									<a class="nav-link text-white" href="/student-dashboard">Dashboard</a>
								{{else if (eq user.role 'Instructor')}}
									<a class="nav-link text-white" href="/instructor-dashboard">Dashboard</a>
								{{/if}}
							</li>
							<li class="nav-item">
								<a class="nav-link text-white" href="/auth/logout"><span class="navbar-text mr-3 text-white">{{user.firstName}} {{user.lastName}} ({{user.role}})</span> | Logout</a>
							</li>
						{{else}}
							<li class="nav-item">
								<a class="nav-link text-white" href="/auth/login">Login</a>
							</li>
							<li class="nav-item">
								<a class="nav-link text-white" href="/auth/register">Register</a>
							</li>
						{{/if}}
					</ul>
				</div>
			</div>
		</nav>

		{{{body}}}
	</body>
</html>